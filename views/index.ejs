<%- include("partials/header.ejs") %>

<main class="dashboard">
  <!-- Hero -->
  <section class="dashboard-intro">
    <p class="eyebrow">YOUR WORLD</p>

    <h1>Where have you been?</h1>

    <p class="subtitle">
      Select the countries and regions you've visited and watch your map come to
      life.
    </p>
  </section>

  <!-- World Map -->
  <section class="map-section">
    <div class="map-header">
      <div>
        <p class="section-label">YOUR MAP</p>
        <h2>World</h2>
      </div>

      <div class="map-count">
        <span class="count-number">12</span>
        <span class="count-label">countries</span>
      </div>
    </div>

    <!-- Map Container -->
    <div id="travelMap"></div>

    <!-- Leaflet JS -->
    <script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"></script>

    <!-- Custom Map Logic -->
    <script>
      // 1. Initialize the map and set the starting coordinates and zoom level
      // (Coordinates here are roughly centered on the world)
      // Define the bounding box of the world
      const worldBounds = [
        [-90, -180], // Southwest
        [90, 180], // Northeast
      ];

      const map = L.map("travelMap", {
        maxBounds: worldBounds,
        maxBoundsViscosity: 1.0, // Prevents dragging outside bounds entirely
        worldCopyJump: false,
      }).setView([20, 0], 2);

      // 3. Fetch the Admin 1 JSON file from your public folder
      fetch("/data/admin0.json")
        .then((response) => {
          if (!response.ok) {
            throw new Error("Network response was not ok");
          }
          return response.json();
        })
        .then((geojsonData) => {
          // 4. Render the GeoJSON data as a layer on the map
          L.geoJSON(geojsonData, {
            style: function (feature) {
              return {
                color: "#343434", // Border color
                weight: 1, // Border thickness
                fillOpacity: 0.1, // Transparency of the state fill
              };
            },
          }).addTo(map);
        })
        .catch((error) => {
          console.error("Error loading the GeoJSON file:", error);
        });
    </script>
    <!-- Toggle Buttons 
    <div class="map-controls">
      <button id="btn-countries" class="active">Countries View</button>
      <button id="btn-regions">Regions View</button>
    </div>-->
  </section>

  <!-- Country Selection -->
  <section class="places-section">
    <div class="places-heading">
      <p class="section-label">PLACES</p>
      <h2>Countries & regions</h2>

      <p>Search or browse the world and mark the places you've visited.</p>
    </div>

    <!-- Search -->
    <div class="country-search">
      <span class="search-icon">⌕</span>

      <input
        type="text"
        id="country-search"
        placeholder="Search countries..."
        autocomplete="off"
      />
    </div>
  </section>
</main>

<%- include("partials/footer.ejs") %>
