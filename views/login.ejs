<%- include("partials/header.ejs") %>

<main class="login-page">

    <section class="login-container">

        <p class="eyebrow">WELCOME TO ODOS</p>

        <h1>Start exploring.</h1>

        <p class="login-description">
            Log your journeys, fill your map and see how much
            of the world you've explored.
        </p>

        <a href="/auth/google" class="google-button">

            <svg
                class="google-icon"
                viewBox="0 0 24 24"
                aria-hidden="true"
            >
                <path
                    fill="#4285F4"
                    d="M21.35 12.2c0-.74-.07-1.45-.19-2.13H12v4.03h5.24a4.48 4.48 0 0 1-1.94 2.94v2.44h3.14c1.84-1.69 2.91-4.18 2.91-7.28z"
                />
                <path
                    fill="#34A853"
                    d="M12 21.7c2.62 0 4.82-.87 6.43-2.36l-3.14-2.44c-.87.58-1.98.93-3.29.93-2.53 0-4.67-1.71-5.44-4.01H3.32v2.52A9.7 9.7 0 0 0 12 21.7z"
                />
                <path
                    fill="#FBBC05"
                    d="M6.56 13.82A5.82 5.82 0 0 1 6.26 12c0-.63.11-1.24.3-1.82V7.66H3.32A9.7 9.7 0 0 0 2.3 12c0 1.56.37 3.03 1.02 4.34l3.24-2.52z"
                />
                <path
                    fill="#EA4335"
                    d="M12 6.17c1.43 0 2.71.49 3.72 1.45l2.79-2.79C16.82 3.26 14.62 2.3 12 2.3a9.7 9.7 0 0 0-8.68 5.36l3.24 2.52C7.33 7.88 9.47 6.17 12 6.17z"
                />
            </svg>

            <span>Continue with Google</span>

        </a>

        <p class="login-note">
            Your travels are saved securely to your account.
        </p>

    </section>

</main>

<%- include("partials/footer.ejs") %>