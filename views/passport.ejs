<%- include("partials/header.ejs") %>

<main class="passport-page">
  <!-- Profile -->
  <h1 class="page-title">Your Passport</h1>
  <section class="passport-header">
    <div class="passport-user">
      <img
        src="<%= user.profile_pic %>"
        alt="<%= user.username %>"
        class="profile-picture"
      />

      <div>
        <h1 class="eyebrow"><%= user.username %></h1>
        <p class="passport-email"><%= user.email %></p>
      </div>
    </div>

    <a href="/logout" class="logout-button"> Log out </a>
  </section>

  <!-- Main Progress -->
  <section class="passport-progress">
    <div class="progress-number">
      <span class="visited-number"> <%=total%> </span>
      <span class="total-number"> / 247</span>
    </div>

    <p>Countries and Territories visited</p>

    <div class="progress-bar">
      <div
        class="progress-fill"
        style="width: <%= (total / 247) * 100 %>%;"
      ></div>
    </div>

    <span class="progress-percentage">
      <%= Math.round((total / 247) * 100) %>% of the world
    </span>
  </section>

  <!-- Main Stats -->

  <section class="stats-section">
    <div class="stats-heading">
      <p class="section-label">YOUR NUMBERS</p>

      <h2>Travel statistics</h2>
    </div>

    <div class="stats-grid">
      <!-- Countries -->
      <div class="stat-card">
        <span class="stat-label"> Member States </span>

        <strong class="stat-value"> COMING SOON </strong>

        <span class="stat-detail"> of 195 </span>
      </div>

      <div class="stat-card">
        <span class="stat-label"> Territories </span>

        <strong class="stat-value"> COMING SOON </strong>

        <span class="stat-detail"> of 49 </span>
      </div>

      <div class="stat-card">
        <span class="stat-label"> Non Member States </span>

        <strong class="stat-value"> COMING SOON </strong>

        <span class="stat-detail"> of 5 </span>
      </div>

      <div class="stat-card">
        <span class="stat-label"> Special Administrative Regions </span>

        <strong class="stat-value"> COMING SOON </strong>

        <span class="stat-detail"> of 2 </span>
      </div>
      <!-- Continents -->

      <div class="stat-card">
        <span class="stat-label"> Continents </span>

        <strong class="stat-value"> COMING SOON </strong>

        <span class="stat-detail"> of 7 continents </span>
      </div>
      <div class="stat-card">
        <span class="stat-label"> Most Visited Continent </span>

        <strong class="stat-value"> COMING SOON </strong>

        <span class="stat-detail"> of 7 continents </span>
      </div>
    </div>
  </section>
  <h1 class="stat-value" style="text-align: center; margin-top: 20px;">Stats Coming Soon...</h1>
</main>

<%- include("partials/footer.ejs") %>
